# Copy to backend/.env and fill in. The backend reads backend/.env.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...        # publishable key
SUPABASE_SERVICE_KEY=                       # secret key (worker storage uploads)
DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

IMAGE_ENGINE_URL=https://<workspace>--genstudio-image.modal.run
VIDEO_ENGINE_URL=https://<workspace>--genstudio-video.modal.run
ENGINE_BEARER_TOKEN=<same value as the genstudio-engine-token Modal secret>

# Postgres connection mode: session (pooler :5432, default) | transaction (pooler :6543,
# scales to many concurrent clients) | direct (db.<ref>.supabase.co, no pooler).
DB_POOL_MODE=session
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8
